{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'knifeblackstore@gmail.com' || root.child('usersDB').child(auth.uid).child('role').val() === 'admin' || root.child('usersDB').child(auth.uid).child('permissions').child('products').val() === true)",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'price', 'type'])"
      }
    },
    "reviews": {
      ".read": true,
      ".write": true,
      "$reviewId": {
        ".validate": "newData.hasChildren(['author', 'text', 'stars'])"
      }
    },
    "contact_messages": {
      ".read": true,
      ".write": true
    },
    "grids": {
      ".read": true,
      ".write": false
    },
    "sales": {
      ".read": true,
      ".write": true
    },
    "finances": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'knifeblackstore@gmail.com' || root.child('usersDB').child(auth.uid).child('role').val() === 'admin' || root.child('usersDB').child(auth.uid).child('permissions').child('finances').val() === true)"
    },
    "subscriptions": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'knifeblackstore@gmail.com' || root.child('usersDB').child(auth.uid).child('role').val() === 'admin' || root.child('usersDB').child(auth.uid).child('permissions').child('finances').val() === true)"
    },
    "discountCodes": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'knifeblackstore@gmail.com' || root.child('usersDB').child(auth.uid).child('role').val() === 'admin' || root.child('usersDB').child(auth.uid).child('permissions').child('coupons').val() === true)"
    },
    "partner_stores": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'knifeblackstore@gmail.com' || root.child('usersDB').child(auth.uid).child('role').val() === 'admin' || root.child('usersDB').child(auth.uid).child('permissions').child('stores').val() === true)"
    },
    "usersDB": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'knifeblackstore@gmail.com' || root.child('usersDB').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.child('role').val() === 'user' || auth.token.email === 'knifeblackstore@gmail.com' || root.child('usersDB').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}