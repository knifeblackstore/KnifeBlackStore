{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'knifeblackstore@gmail.com'",
      "$productId": {
        ".validate": "newData.hasChildren(['name', 'price', 'type'])"
      }
    },
    "reviews": {
      ".read": true,
      ".write": true,
      "$reviewId": {
        ".validate": "newData.hasChildren(['author', 'text', 'stars'])"
      }
    },
    "contact_messages": {
      ".read": true,
      ".write": true
    },
    "grids": {
      ".read": true,
      ".write": false
    },
    "sales": {
      ".read": true,
      ".write": true
    },
    "finances": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'knifeblackstore@gmail.com'"
    },
    "subscriptions": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'knifeblackstore@gmail.com'"
    },
    "discountCodes": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'knifeblackstore@gmail.com'"
    },
    "partner_stores": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'knifeblackstore@gmail.com'"
    },
    "usersDB": {
      ".read": false,
      ".write": false
    }
  }
}